package views

import (
	"strconv"

	"github.com/larsla/takt/web/components/ui"
)

// Overview is the data behind the cluster page.
type Overview struct {
	NATSURL       string
	ServerVersion string
	SchemaVersion int
	Streams       []Store
	KeyValues     []Store
	ObjectStores  []Store
}

// Store describes one stream, KV bucket or object store.
type Store struct {
	Name     string
	Messages uint64
	Bytes    uint64
	Subjects string
}

templ OverviewPage(o Overview) {
	@Layout("Cluster", Nav{Active: "cluster"}) {
		<div class="flex flex-col gap-6">
			<div class="flex items-center justify-between">
				<h1 class="text-2xl font-semibold">Cluster</h1>
				<span class="htmx-indicator text-sm text-muted-foreground" id="refresh-indicator">refreshing</span>
			</div>
			<div id="overview" hx-get="/partials/overview" hx-trigger="every 5s" hx-swap="innerHTML" hx-indicator="#refresh-indicator">
				@OverviewBody(o)
			</div>
		</div>
	}
}

templ OverviewBody(o Overview) {
	<div class="flex flex-col gap-6">
		@ui.Card() {
			@ui.CardHeader("NATS", o.NATSURL)
			@ui.CardContent() {
				<div class="flex flex-wrap gap-2">
					@ui.Badge("secondary", "server "+o.ServerVersion)
					@ui.Badge("outline", "schema v"+strconv.Itoa(o.SchemaVersion))
				</div>
			}
		}
		@storeCard("Streams", "History, task and timer streams", o.Streams, true)
		@storeCard("Key-value buckets", "Mutable state, visibility, pollers", o.KeyValues, false)
		@storeCard("Object stores", "Large payloads", o.ObjectStores, false)
	</div>
}

templ storeCard(title, description string, stores []Store, showSubjects bool) {
	@ui.Card() {
		@ui.CardHeader(title, description)
		@ui.CardContent() {
			if len(stores) == 0 {
				<p class="text-sm text-muted-foreground">None yet.</p>
			} else {
				@ui.Table() {
					if showSubjects {
						@ui.TableHeader("Name", "Subjects", "Messages", "Bytes")
					} else {
						@ui.TableHeader("Name", "Entries", "Bytes")
					}
					@ui.TableBody() {
						for _, s := range stores {
							@ui.TableRow() {
								@ui.TableCell() {
									<span class="font-mono">{ s.Name }</span>
								}
								if showSubjects {
									@ui.TableCell() {
										<span class="font-mono text-muted-foreground">{ s.Subjects }</span>
									}
								}
								@ui.TableCell() {
									{ strconv.FormatUint(s.Messages, 10) }
								}
								@ui.TableCell() {
									{ formatBytes(s.Bytes) }
								}
							}
						}
					}
				}
			}
		}
	}
}
